<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SRT / network stream icin (yerel + internet) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- MediaCodec HW decode / AudioTrack -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- S912'de HW HEVC/H264 decode icin (genelde runtime ile cozulur) -->
    <uses-feature android:name="android.hardware.audio.output" android:required="true" />

    <application
        android:label="S912 Codec"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!--
            MainActivity -> sonraki adimda eklenir (ActivityLayout icinde
            SrtCodecPlayer + MediaCodec HW decode entegrasyonu).
            Iskelet icin asgari Activity:
        -->
        <activity
            android:name=".CodecActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
